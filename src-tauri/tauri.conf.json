{
  "productName": "Split Proxy Island",
  "version": "0.1.0",
  "identifier": "local.splitproxy.island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Split Proxy Island",
        "width": 260,
        "height": 76,
        "skipTaskbar": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false
      },
      {
        "label": "panel",
        "title": "Split Proxy Island - Panel",
        "url": "/?window=panel",
        "width": 476,
        "height": 366,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ApexCore.exe": "ApexCore.exe",
      "../Country.mmdb": "Country.mmdb"
    }
  }
}
