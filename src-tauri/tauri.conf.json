{
  "productName": "Split Proxy Island",
  "version": "0.1.0",
  "identifier": "local.splitproxy.island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Split Proxy Island",
      "width": 420,
      "height": 58,
      "skipTaskbar": true,
      "decorations": false,
      "shadow": false,
      "transparent": true,
      "alwaysOnTop": true,
      "resizable": false
    }]
  },
  "bundle": { "active": false }
}
